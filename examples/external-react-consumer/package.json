{
  "name": "external-react-consumer",
  "version": "0.0.0",
  "private": true,
  "description": "Reference application: an independent React app that integrates SpatialFlex through its package entry points only.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
