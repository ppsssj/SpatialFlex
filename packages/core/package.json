{
  "name": "@spatialflex/core",
  "version": "0.0.0",
  "description": "Framework-agnostic core of SpatialFlex.",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./workspace": {
      "source": "./src/workspace/index.ts",
      "types": "./dist/workspace/index.d.ts",
      "default": "./dist/workspace/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  }
}
