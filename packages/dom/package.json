{
  "name": "@spatialflex/dom",
  "version": "0.0.0",
  "description": "Browser DOM runtime of SpatialFlex: Native DOM spatial placement, containment diagnostics and handle input. No React, no rendering engine.",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@spatialflex/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "jsdom": "^31.0.1"
  }
}
